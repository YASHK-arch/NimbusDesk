# VentureTwin Environment Configuration
# LLM execution mode: 'mock' (default), 'real', 'record', or 'replay'
LLM_MODE=mock
LLM_PROVIDER=gemini

# Provider Models (Explicit configuration required in real/record mode; no implicit fallback defaults)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Provider API Keys (required when LLM_MODE=real or LLM_MODE=record)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///data/venturetwin.db
